APP_NAME=DBNova
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# DBNova — the MySQL server it manages (NOT the app database above).
# .env only says WHERE the server is: never put a MySQL username or password here.
# Users sign in with their own MySQL account. See README → Configuration.
# ---------------------------------------------------------------------------
DBNOVA_DB_HOST=127.0.0.1
DBNOVA_DB_PORT=3306
# Set a socket path to connect through the socket instead of TCP (e.g. /tmp/mysql.sock)
DBNOVA_DB_SOCKET=

# REQUIRED: full paths to the client tools (shell aliases are invisible to PHP).
# Find them with `command -v mysql mysqldump`. Ideally the same version as the server.
#   Linux: /usr/bin/mysql   macOS (Oracle installer): /usr/local/mysql/bin/mysql
#   Homebrew: /opt/homebrew/bin/mysql   MAMP: /Applications/MAMP/Library/bin/mysql80/bin/mysql
DBNOVA_MYSQL_BIN=/usr/bin/mysql
DBNOVA_MYSQLDUMP_BIN=/usr/bin/mysqldump

# true = every change to the server is refused (browsing, SELECT, exports still work)
DBNOVA_READ_ONLY=false

# Defaults for every user. Each user can change them under Settings → Preferences, up to the maximums.
DBNOVA_PAGE_SIZE=100
DBNOVA_QUERY_ROW_CAP=1000
DBNOVA_QUERY_TIMEOUT_MS=30000
DBNOVA_MAX_PAGE_SIZE=1000
DBNOVA_MAX_QUERY_ROW_CAP=10000
DBNOVA_MAX_QUERY_TIMEOUT_MS=300000

# Imports and exports
DBNOVA_MAX_UPLOAD_BYTES=107374182400
# Refuse an import/export that would leave less free disk than this (5 GB)
DBNOVA_MIN_FREE_DISK_BYTES=5368709120
# Finished export files are deleted after this many hours; download links last this many minutes
DBNOVA_EXPORT_FILE_HOURS=24
DBNOVA_EXPORT_LINK_MINUTES=60
# Finished export files one user may keep at once (0 = no limit)
DBNOVA_MAX_KEPT_EXPORTS=10

# Optional: MySQL account limited to dbnova\_test\_% for integration tests
DBNOVA_TEST_DB_USERNAME=
DBNOVA_TEST_DB_PASSWORD=
